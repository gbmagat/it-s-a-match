    "@fontsource/montserrat": "5.2.8",
    "express": "5.3.0",
    "mysql2": "3.24.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "playwright-core": "1.64.1",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=20.6"
  }
}
